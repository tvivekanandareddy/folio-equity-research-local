# Optional server-only PostgreSQL connection. Blank uses local SQLite.
DATABASE_URL=
# Default: source excerpts without embeddings or generated answers.
AI_PROVIDER=evidence
EMBEDDING_PROVIDER=none
# Optional paid OpenAI provider: set your own key privately in .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional local Ollama model, installed and downloaded separately.
OLLAMA_MODEL=qwen3:4b
# Set your own app name and real email before using SEC download/import features.
SEC_USER_AGENT=
